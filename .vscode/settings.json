{
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "emmet.includeLanguages": {
    "typescript": "html",
    "typescriptreact": "html"
  },
  "cSpell.language": "en,es-ES",
  "cSpell.enableFiletypes": [
    "typescript",
    "typescriptreact", 
    "css",
    "html",
    "markdown"
  ],
  "cSpell.dictionaries": [
    "typescript",
    "html",
    "css",
    "es-es",
    "project-words"
  ]
}